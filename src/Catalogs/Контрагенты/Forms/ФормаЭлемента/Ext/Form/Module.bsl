
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Тип = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо") Тогда
		Элементы.КПП.Видимость = Истина;
	ИначеЕсли Объект.Тип = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо") Тогда
		Элементы.КПП.Видимость = Ложь;
	Иначе
		ТекстСообщения = "Не выбран тип контрагента";
		Сообщить(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

